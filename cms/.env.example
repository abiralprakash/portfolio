# Copy to .env and fill in before running the CMS.

# Required. Generate with: node -e "console.log(crypto.randomUUID())"
PAYLOAD_SECRET=replace-me

# SQLite by default. Point at libsql/Turso or Postgres when hosting the CMS.
DATABASE_URI=file:./cms.db

# Seed credentials for the first admin user (used by `npm run seed`).
SEED_ADMIN_EMAIL=hello@prakashadhikari.dev
SEED_ADMIN_PASSWORD=change-this-password

# Optional: Cloudflare R2 media storage. When all four are set, uploads go to R2
# instead of local disk. Leave blank for local authoring.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
