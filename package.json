{
  "name": "prakash-portfolio",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "demo:dev": "vite --config demo/vite.config.js",
    "demo:build": "vite build --config demo/vite.config.js",
    "cms:dev": "npm --prefix cms run dev",
    "cms:seed": "npm --prefix cms run seed",
    "cms:export": "npm --prefix cms run export",
    "deploy": "npm run demo:build && wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.13",
    "vite": "^6.0.7",
    "wrangler": "^4.95.0"
  }
}
